{
  "schemaVersion": 1,
  "id": "paper_plane",
  "version": "${version}",
  "name": "Paper Plane",
  "description": "Paper planes for server-authoritative FTB teleport requests and deterministic gliding.",
  "authors": ["RinChan"],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.rinchan.paperplane.fabric.PaperPlaneFabric"],
    "client": ["dev.rinchan.paperplane.fabric.PaperPlaneFabricClient"]
  },
  "mixins": ["paper_plane.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.9",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "architectury": "*",
    "ftblibrary": "${ftb_library_range}",
    "ftbessentials": "${ftb_essentials_range}"
  }
}

# Standard folded paper dart for Paper Plane
mtllib paper_plane.mtl

o paper_plane
# Nose, center fold, symmetric wing folds, and central keel
v 0.50000 0.64000 1.00000
v 0.50000 0.64000 0.18000
v 0.27000 0.56000 0.40000
v 0.05000 0.48000 0.18000
v 0.73000 0.56000 0.40000
v 0.95000 0.48000 0.18000
v 0.50000 0.40000 0.88000
v 0.50000 0.18000 0.18000

# One clean UV triangle inside each uniform atlas quadrant
vt 0.12500 0.12500
vt 0.37500 0.12500
vt 0.12500 0.37500
vt 0.62500 0.12500
vt 0.87500 0.12500
vt 0.62500 0.37500
vt 0.12500 0.62500
vt 0.37500 0.62500
vt 0.12500 0.87500
vt 0.62500 0.62500
vt 0.87500 0.62500
vt 0.62500 0.87500

# Bright inner folded panels
usemtl paper_light
f 1/4 2/5 3/6
f 1/4 5/6 2/5

# Broad symmetric outer wings
usemtl paper_main
f 1/1 3/2 4/3
f 1/1 6/3 5/2
f 3/1 2/2 4/3
f 2/1 5/2 6/3

# Clean shaded underside; reverse winding makes the thin paper visible below
usemtl paper_shadow
f 3/7 2/8 1/9
f 2/7 5/8 1/9
f 4/7 3/8 1/9
f 5/7 6/8 1/9
f 4/7 2/8 3/9
f 6/7 5/8 2/9

# Central folded keel, rendered from both sides
usemtl paper_fold
f 1/10 7/11 8/12
f 1/10 8/11 2/12
f 7/10 1/11 8/12
f 8/10 1/11 2/12

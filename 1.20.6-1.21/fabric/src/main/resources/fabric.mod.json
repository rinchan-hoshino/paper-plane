{
  "schemaVersion": 1,
  "id": "paper_plane",
  "version": "${version}",
  "name": "Paper Plane",
  "description": "Turn FTB Essentials teleport requests into items.",
  "authors": [
    "RinChan"
  ],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rinchan.paperplane.fabric.PaperPlaneFabric"
    ],
    "client": [
      "dev.rinchan.paperplane.fabric.PaperPlaneFabricClient"
    ]
  },
  "mixins": [
    "paper_plane.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*",
    "ftblibrary": "${ftb_library_version_range}",
    "ftbessentials": "${ftb_essentials_version_range}",
    "rinlib": ">=1.0.2"
  },
  "icon": "icon.png"
}
